#!/usr/bin/env python
"""Enforce: '<type>(<scope>): <summary>' + blank line + body containing 'Why:'.
Enable once per clone with:  git config core.hooksPath .githooks"""

import re
import sys

TYPES = "feat|fix|test|docs|chore|refactor|ci"
HEADER = re.compile(rf"^({TYPES})(\([a-z0-9-]+\))?: .{{5,72}}$")

message = open(sys.argv[1], encoding="utf-8").read()
lines = [line for line in message.splitlines() if not line.startswith("#")]
header = lines[0] if lines else ""
problems = []
if lines and lines[0].startswith("Merge "):
    sys.exit(0)
if not HEADER.match(header):
    problems.append(f"Header must look like 'feat(approvals): short summary' (types: {TYPES}).")
if len(lines) < 3 or lines[1].strip():
    problems.append("Leave one blank line after the header, then write a body.")
if "Why:" not in message:
    problems.append("The body must contain a 'Why:' line explaining the reason for the change.")

if problems:
    print("Commit message rejected:\n  - " + "\n  - ".join(problems), file=sys.stderr)
    sys.exit(1)
